#!/bin/bash

# Set HOME so Anki writes config to /config
export HOME=/config

# Qt/Chromium environment variables for container compatibility
export QTWEBENGINE_DISABLE_SANDBOX=1
export QT_QPA_PLATFORM=xcb
export QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --disable-gpu --disable-software-rasterizer"

# Configure Anki data directories
ADDONS_DIR="/config/.local/share/Anki2/addons21"
mkdir -p /config/.local/share/Anki2/backups
mkdir -p "$ADDONS_DIR"

# Configure sync server if environment variable is set
if [ -n "$ANKI_SYNC_SERVER" ]; then
    mkdir -p /config/.local/share/Anki2
    cat > /config/.local/share/Anki2/prefs21.toml <<EOF
[sync]
endpoint = "$ANKI_SYNC_SERVER"
EOF
    echo "[INFO] Anki sync server configured: $ANKI_SYNC_SERVER"
fi

# ---------------------------------------------------------------------------
# AnkiConnect (addon 2055492159)
# ---------------------------------------------------------------------------
if [ "${ANKICONNECT_ENABLED:-true}" = "true" ]; then
    ANKICONNECT_DIR="$ADDONS_DIR/2055492159"
    # Auto-install from staging if not yet present in persistent storage
    if [ ! -d "$ANKICONNECT_DIR" ]; then
        echo "[INFO] Installing AnkiConnect from staging..."
        mkdir -p "$ANKICONNECT_DIR"
        cp -a /opt/anki-addons-staging/2055492159/. "$ANKICONNECT_DIR/"
        echo "[INFO] AnkiConnect installed."
    fi
    # Always write config so bind address / CORS settings are correct
    cat > "$ANKICONNECT_DIR/config.json" <<EOF
{
    "apiKey": null,
    "apiLogPath": null,
    "ignoreOriginList": [],
    "webBindAddress": "0.0.0.0",
    "webBindPort": ${ANKICONNECT_PORT:-8765},
    "webCorsOriginList": ["*"]
}
EOF
    echo "[INFO] AnkiConnect configured to listen on 0.0.0.0:${ANKICONNECT_PORT:-8765}"
fi

# ---------------------------------------------------------------------------
# Anki Beacon (addon 1577021707)
# ---------------------------------------------------------------------------
if [ "${ANKIBEACON_ENABLED:-true}" = "true" ]; then
    BEACON_DIR="$ADDONS_DIR/1577021707"
    # Auto-install from staging if not yet present in persistent storage
    if [ ! -d "$BEACON_DIR" ]; then
        echo "[INFO] Installing Anki Beacon from staging..."
        mkdir -p "$BEACON_DIR"
        cp -a /opt/anki-addons-staging/1577021707/. "$BEACON_DIR/"
        echo "[INFO] Anki Beacon installed."
    fi
    # Write config if ANKIBEACON_URL is set, otherwise preserve the addon's own default config
    if [ -n "$ANKIBEACON_URL" ]; then
        cat > "$BEACON_DIR/config.json" <<EOF
{
  "defaults": {
    "timeout_seconds": 5,
    "headers": {},
    "show_error_tooltips": true
  },
  "operations": [
    {
      "operation": "note_added",
      "enabled": true,
      "urls": ["${ANKIBEACON_URL}"],
      "payload_mode": "note_id"
    },
    {
      "operation": "heartbeat",
      "enabled": true,
      "urls": [],
      "fallback_operation": "note_added",
      "interval_seconds": 10,
      "show_error_tooltips": false
    }
  ]
}
EOF
        echo "[INFO] Anki Beacon configured with URL: ${ANKIBEACON_URL}"
    else
        echo "[INFO] Anki Beacon using default config (edit addons21/1577021707/config.json to customize)"
    fi
fi

# ---------------------------------------------------------------------------
# Local Audio Server for Yomichan/Yomitan (yomidevs/local-audio-yomichan)
# ---------------------------------------------------------------------------
if [ "${LOCALAUDIO_ENABLED:-true}" = "true" ]; then
    LOCALAUDIO_DIR="$ADDONS_DIR/local-audio-yomichan"
    # Auto-install from staging if not yet present in persistent storage
    if [ ! -d "$LOCALAUDIO_DIR" ]; then
        echo "[INFO] Installing Local Audio for Yomichan from staging..."
        mkdir -p "$LOCALAUDIO_DIR"
        cp -a /opt/anki-addons-staging/local-audio-yomichan/. "$LOCALAUDIO_DIR/"
        echo "[INFO] Local Audio for Yomichan installed."
    fi
    LOCALAUDIO_PORT="${LOCALAUDIO_PORT:-5050}"
    python3 - "$LOCALAUDIO_DIR/config.json" "$LOCALAUDIO_PORT" <<'EOF'
import json, sys
path, port = sys.argv[1], int(sys.argv[2])
try:
    with open(path, encoding="utf-8") as f:
        cfg = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    cfg = {}
cfg["port"] = port
with open(path, "w", encoding="utf-8") as f:
    json.dump(cfg, f, indent=4)
    f.write("\n")
EOF
    echo "[INFO] Local Audio for Yomichan configured on 0.0.0.0:${LOCALAUDIO_PORT}"
fi

# Launch Anki (26.x self-contained bundle - no launcher needed)
exec /opt/anki/anki 2>/dev/null
